@startuml
title Libra — Пользовательский сценарий выдачи книги

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
    BackgroundColor white
    BorderColor #555555
    FontColor #222222
}

|Читатель|

start
:Вход в систему;
:Поиск книги;
:Просмотр информации;
:Проверка доступности;

if (Книга доступна?) then (Да)
    :Создание бронирования;
else (Нет)
    :Постановка в очередь;
    :Ожидание уведомления;
endif

|Библиотекарь|

:Просмотр бронирования;
:Подготовка экземпляра;
:Оформление выдачи;

|Читатель|

:Получение книги;
:Использование книги;

if (Нужно продление?) then (Да)
    :Запрос продления;

    |Библиотекарь|
    :Проверка возможности продления;
    :Продление срока;

    |Читатель|
endif

:Возврат книги;

|Библиотекарь|

:Оформление возврата;
:Проверка просрочки;

if (Есть просрочка?) then (Да)
    :Начисление штрафа;
endif

|Читатель|

:Просмотр истории выдач;
:Просмотр задолженности;

stop

@enduml